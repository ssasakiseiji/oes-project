# Server Configuration
PORT=3001

# Database Configuration
DB_USER=your_database_user
DB_HOST=localhost
DB_DATABASE=inflacion_app
DB_PASSWORD=your_database_password
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Environment
NODE_ENV=development

# Error tracking (opcional - dejar vacío para desactivar)
SENTRY_DSN=

# Tamaño del pool de conexiones a Postgres (subir en VPS con proceso persistente)
DB_POOL_MAX=10
