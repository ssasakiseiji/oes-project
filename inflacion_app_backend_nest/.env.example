# Prisma necesita import "dotenv/config" en prisma.config.ts para leer esto
# (ver prisma.config.ts). En runtime, PrismaService también lee DATABASE_URL
# directo de process.env (ver src/prisma/prisma.service.ts).
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Server
PORT=3002
NODE_ENV=development

# DB_SSL=false para Postgres self-hosted en la red interna de Docker (VPS).
# true (default) para el pooler de Supabase.
DB_SSL=true

# JWT (mismo valor que inflacion_app_backend/.env mientras conviven ambos backends)
JWT_SECRET=cambiar_este_secreto_jwt

FRONTEND_URL=http://localhost:5173
