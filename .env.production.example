# Copiar a ".env" en la raíz del repo (ese archivo ya está en .gitignore) y completar
# con valores reales antes de correr: docker compose up -d --build

# Postgres
DB_USER=inflacion_app
DB_PASSWORD=cambiar_esta_contraseña
DB_DATABASE=inflacion_app

# Backend
JWT_SECRET=cambiar_este_secreto_jwt
FRONTEND_URL=https://tu-dominio.com
SENTRY_DSN=

# Frontend (build-time)
VITE_API_URL=/api
VITE_SENTRY_DSN=
